# Yosys synthesis and topology analysis for both complete 8-bit ALUs.
# Run from repository root: yosys -s synthesis/run_synthesis.ys
# The archived comparison uses synth with flattening followed by ltp -noff.
# Exact metrics can vary with Yosys/ABC versions; inspect logs before updating the report.

read_verilog rtl/full_adder.v
read_verilog rtl/ripple_carry_adder.v
read_verilog rtl/alu_rca.v
hierarchy -check -top alu_rca
synth -top alu_rca -flatten
check
tee -o reports/alu_rca_synthesis.log stat
tee -a reports/alu_rca_synthesis.log ltp -noff
write_json reports/alu_rca.json
write_verilog reports/alu_rca_synth.v

design -reset

read_verilog rtl/full_adder.v
read_verilog rtl/carry_lookahead_adder.v
read_verilog rtl/alu_cla.v
hierarchy -check -top alu_cla
synth -top alu_cla -flatten
check
tee -o reports/alu_cla_synthesis.log stat
tee -a reports/alu_cla_synthesis.log ltp -noff
write_json reports/alu_cla.json
write_verilog reports/alu_cla_synth.v

# Generic logic statistics and topological depth only; not physical area,
# delay in nanoseconds, or power. The reports directory must already exist.
